{
  "name": "test-app",
  "type": "module",
  "private": true,
  "dependencies": {
    "@pikku/addon-console": "workspace:*",
    "@pikku/addon-graph": "workspace:*",
    "@pikku/better-auth": "^0.12.64",
    "@pikku/code-edit": "workspace:*",
    "@pikku/core": "^0.12.154",
    "@pikku/jose": "workspace:^",
    "@pikku/kysely": "workspace:^",
    "@pikku/schema-cfworker": "^0.12.9",
    "better-auth": "^1.7.10",
    "eventsource": "^5.1.3",
    "kysely": "^0.29.6",
    "ws": "^8.22.0",
    "zod": "^4",
    "@pikku/aws-services": "^0.12.19",
    "@pikku/kysely-postgres": "^0.12.28",
    "@pikku/lambda": "^0.12.14",
    "kysely-postgres-js": "^5.0.1",
    "postgres": "^3.4.9",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pikku/cli": "^0.12.208",
    "@pikku/cloudflare": "workspace:*",
    "@pikku/azure-functions": "workspace:*",
    "@pikku/bun-server": "workspace:*",
    "@pikku/deploy-azure": "workspace:*",
    "@pikku/deploy-cloudflare": "workspace:*",
    "@pikku/deploy-serverless": "workspace:*",
    "@pikku/deploy-standalone": "workspace:*",
    "@pikku/fetch": "^0.12.15",
    "@pikku/kysely-node-sqlite": "workspace:*",
    "@pikku/lambda": "workspace:*",
    "@pikku/modelcontextprotocol": "workspace:*",
    "@pikku/node-http-server": "workspace:*",
    "@pikku/schedule": "workspace:*",
    "@pikku/websocket": "^0.12.6",
    "@pikku/ws": "^0.12.11",
    "@standard-schema/spec": "^1.1.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26",
    "@types/ws": "^8",
    "concurrently": "^10.0.6",
    "serverless": "^4.44.0",
    "serverless-offline": "^14.8.3",
    "serverless-offline-sqs": "^9.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/cloudfront-signer": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "esbuild": "~0.28.2",
    "serverless-esbuild": "^1.57.2",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "scripts": {
    "build": "npm run build:offline --external:\"@aws-sdk/*\"",
    "ncu:pikku": "npx npm-check-updates -f '/@pikku/.*/'",
    "pikku": "pikku all",
    "test:http-fetch": "npx tsx client/http-fetch.ts",
    "test:http-sse": "npx tsx client/http-sse.ts",
    "test:mcp": "npx tsx client/mcp.ts",
    "test:mcp:http": "npx tsx client/mcp-http.ts",
    "test:queue": "npx tsx client/queue.ts",
    "test:rpc": "npx tsx client/rpc.ts",
    "test:runtime-rpc": "npx tsx client/runtime-rpc.ts",
    "test:websocket": "npx tsx client/websocket.ts",
    "test:cli:local": "npx tsx client/cli-local.gen.ts",
    "test:cli:raw": "npx tsx client/cli-raw.ts list",
    "test:workflows": "npx tsx client/workflow.ts",
    "test:triggers": "npx tsx client/trigger.ts",
    "test:agent-http": "npx tsx client/agent-http.ts",
    "test:agent-sse": "npx tsx client/agent-sse.ts",
    "test:runtime": "npx tsx scripts/test-runtime.ts",
    "start:mcp:http": "npx tsx scripts/start-mcp-http.ts",
    "build:offline": "rm -rf dist && esbuild ./src/websocket.ts --format=esm --minify --bundle --keep-names --sourcemap --platform=node --target=node24 --outdir=dist --out-extension:.js=.mjs --metafile=meta.json --packages=external",
    "start": "npm run build:offline && SLS_TELEMETRY_DISABLED=1 SLS_NOTIFICATIONS_MODE=off serverless offline",
    "dev": "npm run build:offline && serverless offline",
    "test": "npm run test:websocket",
    "deploy": "npm run build && serverless deploy",
    "postinstall": "pikku all",
    "stackblitz": "concurrently 'pikku watch --silent' 'npm run dev'",
    "lint": "oxlint --type-aware"
  },
  "imports": {
    "#pikku/*.js": "./pikku-gen/*.ts",
    "#pikku/*": [
      "./pikku-gen/*/index.ts",
      "./pikku-gen/*"
    ]
  },
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "stackblitz": {
    "startCommand": "npm run stackblitz"
  }
}